# Model configuration (specified at lab start, e.g., gemini-2.0-flash-exp or gemini-1.5-pro)
MODEL="gemini-2.0-flash"

# Google Cloud Service Account (auto-bound in lab via ${PROJECT_NUMBER}-compute@developer.gserviceaccount.com)
SERVICE_ACCOUNT="PROJECT_NUMBER-compute@developer.gserviceaccount.com"

# Enterprise settings
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_LOCATION=global

# Secure Remote MCP Server URL (pre-deployed Cloud Run service)
MCP_SERVER_URL=https://zoo-mcp-server-PROJECT_NUMBER.REGION.run.app/mcp/
